generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth Models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          String    @default("USER") // USER, ADMIN
  accounts      Account[]
  sessions      Session[]
  chatSessions  ChatSession[]
  followedInstitutions FollowedInstitution[]
  followedFunds        FollowedFund[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// App Models
model Institution {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  shortName   String
  type        String
  location    String
  reports     Report[]
  namedFunds  NamedFund[]
  followedBy  FollowedInstitution[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Report {
  id                    String        @id @default(cuid())
  institutionId         String
  year                  Int
  fy                    String
  fiscalYearEnd         String
  published             String
  auditOpinion          String        @default("Unmodified")
  
  totalRevenue          Float
  totalExpenses         Float
  netPosition           Float
  totalAssets           Float
  totalLiabilities      Float
  totalNetAssets        Float
  totalDebt             Float
  endowment             Float
  privateGiftsOperating Float

  lockboxEndowmentTotal         Float
  lockboxPermanentlyRestricted  Float
  lockboxBoardDesignated        Float
  lockboxSpendingRate           Float
  lockboxAnnualPayout           Float

  institution           Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  lineItems             LineItem[]
  chatSessions          ChatSession[]

  @@unique([institutionId, year])
}

model LineItem {
  id       String @id @default(cuid())
  reportId String
  type     String // "REVENUE" or "EXPENSE"
  label    String
  value    Float

  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model NamedFund {
  id              String      @id @default(cuid())
  institutionId   String
  name            String
  purpose         String
  restrictionType String      // "Scholarship", "Fellowship", "Research", "Capital"
  marketValue     Float
  spendingRate    Float
  established     Int

  institution     Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  followedBy      FollowedFund[]
}

// A donor's "track this institution/fund" state — used to drive the portal
// dashboard's tracked lists. Previously lived only in browser localStorage under
// one global key, which meant any account created in the same browser inherited
// whatever the last signed-in account had tracked. Scoping it to the user row
// closes that leak and matches how everything else user-specific (chat history)
// is already persisted.
model FollowedInstitution {
  id            String   @id @default(cuid())
  userId        String
  institutionId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([userId, institutionId])
}

model FollowedFund {
  id        String   @id @default(cuid())
  userId    String
  fundId    String
  createdAt DateTime @default(now())

  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fund NamedFund @relation(fields: [fundId], references: [id], onDelete: Cascade)

  @@unique([userId, fundId])
}

model DraftReport {
  id            String   @id @default(cuid())
  fileName      String?
  fileUrl       String?
  status        String   @default("PENDING") // PENDING (awaiting review), PUBLISHED, FAILED
  extractedData String?  // JSON string
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String?
  reportId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

model ChatMessage {
  id            String      @id @default(cuid())
  chatSessionId String
  role          String      // "user" or "model"
  content       String
  createdAt     DateTime    @default(now())

  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}
